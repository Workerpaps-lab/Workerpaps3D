import os

def generate_model(prompt):

    os.makedirs("models", exist_ok=True)

    if "pyramid" in prompt.lower():

        model = """
o Pyramid
v 0 0 0
v 1 0 0
v 1 1 0
v 0 1 0
v 0.5 0.5 1
f 1 2 5
f 2 3 5
f 3 4 5
f 4 1 5
f 1 2 3 4
"""

    else:

        model = """
o Cube
v 0 0 0
v 1 0 0
v 1 1 0
v 0 1 0
v 0 0 1
v 1 0 1
v 1 1 1
v 0 1 1
f 1 2 3 4
f 5 6 7 8
"""

    path = "models/model.obj"

    with open(path,"w") as f:
        f.write(model)

    return path
let currentModel

function generateModel(){

let prompt = document.getElementById("prompt").value

if(currentModel){
scene.remove(currentModel)
}

let geometry

if(prompt.toLowerCase().includes("sphere")){
geometry = new THREE.SphereGeometry(1,32,32)
}
else if(prompt.toLowerCase().includes("pyramid")){
geometry = new THREE.ConeGeometry(1,2,4)
}
else{
geometry = new THREE.BoxGeometry(1,1,1)
}

let material = new THREE.MeshStandardMaterial({color:0x00ffcc})

currentModel = new THREE.Mesh(geometry,material)

scene.add(currentModel)

}
function downloadModel(){

if(!currentModel) return

const exporter = new THREE.Object3D()

exporter.add(currentModel)

const data = JSON.stringify(exporter)

const blob = new Blob([data],{type:"application/json"})

const a = document.createElement("a")

a.href = URL.createObjectURL(blob)

a.download = "model.json"

a.click()

}
