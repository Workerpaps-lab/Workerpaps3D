import os

def generate_model(prompt):

    os.makedirs("models", exist_ok=True)

    if "pyramid" in prompt.lower():

        model = """
o Pyramid
v 0 0 0
v 1 0 0
v 1 1 0
v 0 1 0
v 0.5 0.5 1
f 1 2 5
f 2 3 5
f 3 4 5
f 4 1 5
f 1 2 3 4
"""

    else:

        model = """
o Cube
v 0 0 0
v 1 0 0
v 1 1 0
v 0 1 0
v 0 0 1
v 1 0 1
v 1 1 1
v 0 1 1
f 1 2 3 4
f 5 6 7 8
"""

    path = "models/model.obj"

    with open(path,"w") as f:
        f.write(model)

    return path
